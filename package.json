{
  "name": "botly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Botly — plataforma multi-conta para vender acesso a canais do Telegram por bots (planos, Pix, upsell, renovação e corte automáticos)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && vite build --config panel-web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p panel-web/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "build:web": "vite build --config panel-web/vite.config.ts",
    "dev:panel": "vite --config panel-web/vite.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  }
}
